  "types": "dist/ai-cli.d.ts",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://github.com/felixarntz/packages/blob/main/packages/ai-cli/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixarntz/packages.git",
    "directory": "packages/ai-cli"
  },
  "bugs": {
    "url": "https://github.com/felixarntz/packages/issues"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.13",
    "@ai-sdk/openai": "^3.0.18",
    "@ai-sdk/provider": "^3.0.5",
    "@ai-sdk/xai": "^3.0.34",
    "@commander-js/extra-typings": "^13.1.0",
    "@felixarntz/cli-utils": "workspace:^",
    "@google/genai": "^1.38.0",
    "ai": "^6.0.49",
    "ai-code-agents": "^0.2.0",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "file-type": "^21.3.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
