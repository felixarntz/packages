{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "plugins": ["./node_modules/@felixarntz/biome/rules/all.grit"],
  "linter": {
    "rules": {
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            // noPropertyAccessFromIndexSignature in tsconfig.json requires bracket notation
            // for index signature types (e.g. OptionsInput = Record<string, ...>),
            // which conflicts with useLiteralKeys preferring dot notation.
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/*/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
