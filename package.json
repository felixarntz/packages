{
  "name": "@felixarntz/root",
  "private": true,
  "homepage": "https://github.com/felixarntz/packages#readme",
  "bugs": {
    "url": "https://github.com/felixarntz/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixarntz/packages.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ai-image": "DEBUG=true node ./packages/ai-image-cli/dist/cli.js",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "ultracite check",
    "check:deps": "syncpack lint",
    "ci:release": "turbo build --filter='./packages/*' && changeset publish",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "doctor": "ultracite doctor",
    "felixarntz": "DEBUG=true node ./packages/felixarntz/dist/cli.js",
    "fix": "ultracite fix",
    "konsistent": "turbo run konsistent:validate konsistent:check --log-order=grouped --log-prefix=none",
    "konsistent:check": "konsistent",
    "konsistent:validate": "konsistent validate",
    "prepare": "husky",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "wp-plugins": "DEBUG=true node ./packages/wp-plugins-cli/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^2.31.0",
    "@felixarntz/biome": "^0.4.0",
    "@types/node": "^24.10.9",
    "husky": "^9.1.7",
    "konsistent": "^1.0.0-beta",
    "syncpack": "^15.2.0",
    "turbo": "^2.11.10",
    "ultracite": "^8.1.1"
  },
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
