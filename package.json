  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "^3.2.4",
    "glob": "^10.5.0",
    "husky": "^9.1.7",
    "mock-fs": "^5.5.0",
    "syncpack": "^15.2.0",
    "tsup": "catalog:",
